{
  "name": "syrinx",
  "version": "0.4.2",
  "description": "Sound sources as JavaScript, compiled to PCM. This package is the JS host; the Rust library and CLI in the same repository are the reference implementation.",
  "license": "MIT",
  "author": "Dominic Grostate",
  "homepage": "https://github.com/archwyvern/syrinx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archwyvern/syrinx.git"
  },
  "bugs": {
    "url": "https://github.com/archwyvern/syrinx/issues"
  },
  "keywords": [
    "audio",
    "synthesis",
    "sound-design",
    "procedural-audio",
    "deterministic",
    "v8",
    "compiler"
  ],
  "type": "module",
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./browser": {
      "types": "./js/browser.d.ts",
      "default": "./js/browser.js"
    },
    "./check": "./js/check.js",
    "./prelude": "./prelude/prelude.js",
    "./prelude/prelude.js": "./prelude/prelude.js",
    "./prelude/math.js": "./prelude/math.js",
    "./prelude/run.js": "./prelude/run.js",
    "./prelude/run.module.js": "./prelude/run.module.js",
    "./spec": "./SPEC.md",
    "./docs": "./docs/syrinx-docs.json",
    "./prelude/syrinx.d.ts": "./prelude/syrinx.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "js",
    "prelude",
    "docs/syrinx-docs.json",
    "docs/API.md",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
