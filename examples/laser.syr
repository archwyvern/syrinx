// A short sci-fi laser: pitch sweep on a band-limited saw, a touch of noise, tight envelope.
// One layer: nothing here is worth auditioning apart from the rest of it.
import { BlepOsc, Osc, Noise, Biquad, Env, render, filter, normalize, softclip } from "../framework/dsp.js";
import { crack } from "./lib/space.js";

export const meta = { api: 4, name: "laser", duration: 0.35, channels: 1, seed: 7 };

export const stems = {
  laser(ctx) {
    const osc = BlepOsc.saw(ctx.sr);
    const sub = Osc.sine(ctx.sr);
    const noise = new Noise(ctx.seed);
    const lp = Biquad.lowpass(ctx.sr, 6000, 2);
    const freq = Env.sweep(2400, 180, 0.3);
    const amp = Env.ad(0.003, 0.09);
    const hiss = Env.exp(0.02);
    const tick = crack(ctx, { seed: ctx.seed + 1, freq: 5000, decay: 0.002, gain: 1.2 });

    const dry = render(ctx, (t) => {
      const f = freq(t);
      const body = osc.next(f) * 0.6 + sub.next(f * 0.5) * 0.4;
      const crackle = noise.white() * hiss(t) * 0.5;
      return softclip((body + crackle) * 1.6) * amp(t) + tick(t);
    });
    return normalize(filter(dry, lp));
  },
};
